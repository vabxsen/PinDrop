# --- General ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (Supabase in prod: DATABASE_URL = pooled/pgbouncer, DIRECT_URL = direct) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pindrop?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pindrop?schema=public

# --- JWT / sessions ---
JWT_ACCESS_SECRET=changeme_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=changeme_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_REFRESH_EXPIRES_IN_REMEMBER_DAYS=30

COOKIE_SECRET=changeme_cookie_secret_min_32_chars_long
CSRF_SECRET=changeme_csrf_secret_min_32_chars_long

BCRYPT_SALT_ROUNDS=12

# --- Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Nominatim reverse geocoding ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PinDrop/1.0 (contact: you@example.com)
NOMINATIM_MIN_INTERVAL_MS=1000
NOMINATIM_CACHE_TTL_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
VISITOR_RATE_LIMIT_MAX=20

# --- Realtime ---
SOCKET_CORS_ORIGIN=http://localhost:5173

# --- Email (password reset). Leave blank in dev to log reset URLs to console instead. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PinDrop <no-reply@pindrop.app>

LOG_LEVEL=info
